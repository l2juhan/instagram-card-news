    "headline": "After — 감춘 상세",
    "body": "<span class='k'>function</span> <span class='fn'>App</span>() {<br>&nbsp;&nbsp;<span class='k'>return</span> (<br>&nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class='t'>AuthGuard</span>&gt;<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class='t'>LoginStartPage</span> /&gt;<br>&nbsp;&nbsp;&nbsp;&nbsp;&lt;/<span class='t'>AuthGuard</span>&gt;<br>&nbsp;&nbsp;);<br>}<br><br><span class='k'>function</span> <span class='fn'>AuthGuard</span>({ children }) {<br>&nbsp;&nbsp;<span class='k'>const</span> status = <span class='fn'>useCheckLoginStatus</span>();<br><br>&nbsp;&nbsp;<span class='fn'>useEffect</span>(() =&gt; {<br>&nbsp;&nbsp;&nbsp;&nbsp;<span class='k'>if</span> (status === <span class='s'>\"LOGGED_IN\"</span>) {<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;location.href = <span class='s'>\"/home\"</span>;<br>&nbsp;&nbsp;&nbsp;&nbsp;}<br>&nbsp;&nbsp;}, [status]);<br><br>&nbsp;&nbsp;<span class='k'>return</span> status !== <span class='s'>\"LOGGED_IN\"</span> ? children : <span class='k'>null</span>;<br>}<br><br><span class='c'>// 로그인 분기는 AuthGuard가 도맡는다</span>",
    "style_override": "@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap');.container{padding:54px 60px 80px;justify-content:center}.headline{font-size:50px;margin-bottom:6px}.accent-line{display:none}.body{margin-top:30px;background:#21252B;border:1px solid #2C313A;border-left:7px solid #3DDC97;border-radius:16px;padding:38px 42px;font-family:'JetBrains Mono','Menlo',monospace;font-size:26px;line-height:1.55;color:#ABB2BF;white-space:normal}.body .k{color:#C678DD;font-weight:600}.body .s{color:#98C379}.body .fn{color:#61AFEF}.body .t{color:#E5C07B}.body .c{color:#5C6370;font-style:italic}"
