    "style_override": "@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap');.container{padding:60px 60px 90px;justify-content:center}.headline{font-size:50px;margin-bottom:6px}.accent-line{display:none}.body{margin-top:36px;background:#21252B;border:1px solid #2C313A;border-left:7px solid #FF5C5C;border-radius:16px;padding:42px 44px;font-family:'JetBrains Mono','Menlo',monospace;font-size:30px;line-height:1.62;color:#ABB2BF;white-space:normal}.body .k{color:#C678DD;font-weight:600}.body .s{color:#98C379}.body .fn{color:#61AFEF}.body .t{color:#E5C07B}.body .c{color:#5C6370;font-style:italic}"
