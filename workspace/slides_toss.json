    "headline": "Before — 섞인 코드",
    "body": "<span class='k'>function</span> <span class='fn'>SubmitButton</span>() {<br>&nbsp;&nbsp;<span class='k'>const</span> isViewer = <span class='fn'>useRole</span>() === <span class='s'>\"viewer\"</span>;<br>&nbsp;&nbsp;<span class='fn'>useEffect</span>(() =&gt; {<br>&nbsp;&nbsp;&nbsp;&nbsp;<span class='k'>if</span> (isViewer) <span class='k'>return</span>;<br>&nbsp;&nbsp;&nbsp;&nbsp;<span class='fn'>showButtonAnimation</span>();<br>&nbsp;&nbsp;}, [isViewer]);<br>&nbsp;&nbsp;<span class='k'>return</span> isViewer ? (<br>&nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class='t'>TextButton</span> disabled&gt;Submit&lt;/<span class='t'>TextButton</span>&gt;<br>&nbsp;&nbsp;) : (<br>&nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class='t'>Button</span> type=<span class='s'>\"submit\"</span>&gt;Submit&lt;/<span class='t'>Button</span>&gt;<br>&nbsp;&nbsp;);<br>}<br><br><span class='c'>// viewer·일반 로직이 한 컴포넌트에 교차</span>",
